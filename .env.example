# Clanker dev environment. Copy to .env (git-ignored), then load it in your shell:
#   source .env
# and run Gradle as usual, e.g. ./gradlew runClient

# Java 25. The Homebrew "opt" link stays valid across upgrades.
export JAVA_HOME=/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home
export PATH="$JAVA_HOME/bin:$PATH"

# API key. Leave unset to use ~/.clanker/api-key.txt or the in-game settings.
# Setting it here overrides both.
# export CLANKER_API_KEY=

# Optional test switches (see CLAUDE.md)
# export CLANKER_LIVE_TEST=1      # live model smoke test in runGameTest (costs a fraction of a cent)
# export CLANKER_LIVE_MODEL=gpt-5-mini
# export CLANKER_LIVE_EFFORT=low
# export CLANKER_VOICE_TEST=1     # voice game tests (needs the voice models downloaded)
